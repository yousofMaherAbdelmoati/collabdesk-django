DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ENV=development
POSTGRES_DB=collabdesk
POSTGRES_USER=collabdesk
POSTGRES_PASSWORD=local-development-only
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_TEST_DB=test_collabdesk
REDIS_URL=redis://redis:6379/0
# A deliberately visible demo pace; the assistant emits a fixed local SSE response.
ASSISTANT_STREAM_TOKEN_DELAY_SECONDS=0.1
# Production-only: set explicit public hosts/origins, keep DEBUG false, and
# enable this only behind a proxy that overwrites X-Forwarded-Proto.
# DJANGO_ALLOWED_HOSTS=desk.example.com
# CSRF_TRUSTED_ORIGINS=https://desk.example.com
# CORS_ALLOWED_ORIGINS=https://desk.example.com
# WEBSOCKET_ALLOWED_ORIGINS=https://desk.example.com
# DJANGO_TRUST_X_FORWARDED_PROTO=true
